# Server-only Minds configuration. Never expose these values to browser code.
MINDS_BUILDER_API_KEY=
MINDS_MIND_ID=
MINDS_CONVERSATION_ALIAS=reeti-main

# Optional private Telegram follow-up path.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional local worker authentication. Use a long random value in .env.
REETI_WORKER_SECRET=

# Optional local database location. Defaults to data/reeti.db.
REETI_DB_PATH=

# Optional verified public origin. Leave blank for local/private use.
NEXT_PUBLIC_SITE_URL=
